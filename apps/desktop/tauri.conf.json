{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Mobile Runtime",
  "version": "0.1.0",
  "identifier": "dev.umr.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://127.0.0.1:27300"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Mobile Runtime — Setup",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
